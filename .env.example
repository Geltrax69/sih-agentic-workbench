# ---------------------------------------------------------------------------
# Sovereign Agentic AI Workbench — example environment
# Copy to .env and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENV=development
LOG_LEVEL=info

# --- PostgreSQL (control plane + pgvector) ---
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench-dev-only
POSTGRES_DB=workbench
POSTGRES_PORT=5432
DATABASE_URL=postgres://workbench:workbench-dev-only@localhost:5432/workbench?sslmode=disable

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (object storage) ---
MINIO_ROOT_USER=workbench
MINIO_ROOT_PASSWORD=workbench-dev-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=workbench-documents
S3_USE_SSL=false

# --- Go API ---
API_PORT=8080
API_HOST=localhost
# 32+ byte random string for JWT signing (dev value only)
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin#Dev1
# Shared secret between Go control plane and Python AI service
INTERNAL_API_SECRET=internal-dev-only-change-me

# --- Python AI service ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# --- Local model endpoints (OpenAI-compatible) ---
# Ollama default: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_EMBEDDING_MODEL=nomic-embed-text
# Sovereign mode: when false, the system must NEVER contact a remote model endpoint
AI_ALLOW_CLOUD=false

# --- Ports for the web dev server ---
WEB_PORT=3000
